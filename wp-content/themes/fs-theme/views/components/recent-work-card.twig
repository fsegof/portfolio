<div class="c-recent-work-card wow animate__animated animate__fadeInUp">
	<img src="{{ image(image) }}" alt="{{ altText }}">
	<a target="_blank" href="{{ link }}" class="c-recent-work-card__description">
		<h3 class="c-recent-work-card__description__title">{{ title }}</h3>
		<p class="c-recent-work-card__description__text">{{ description }}</p>
		<div class="c-recent-work-card__description__tags">
			{% for tag in tags %}
				<span class="c-recent-work-card__description__tags__tag">{{ tag }}</span>
			{% endfor %}
		</div>
		{{ load_svg("icon-arrow.svg") }}
	</a>
</div>
